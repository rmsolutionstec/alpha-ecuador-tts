build/
dist/
*.egg-info/
*.spec

# Audio y archivos temporales.
*.mp3
*.wav
*.ogg
*.flac
*.part
*.tmp
logs/
tests/tmp*/

# Editores y archivos del sistema operativo.
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
